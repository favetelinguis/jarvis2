#!/usr/bin/python3
"""Open a validated HexDocs URL in a terminal browser."""
import os
import shutil
import sys
import urllib.parse


def main():
    url = os.environ.get('JARVIS2_DOCS_URL', '')
    parts = urllib.parse.urlsplit(url)
    if (len(url.encode()) > 2048 or parts.scheme != 'https' or parts.hostname != 'hexdocs.pm'
            or parts.username is not None or parts.password is not None
            or parts.port not in (None, 443) or not parts.path.startswith('/')
            or any(c.isspace() or ord(c) < 32 or ord(c) == 127 for c in url)):
        raise ValueError('invalid URL')
    browser = shutil.which('w3m')
    if not browser:
        print('Install w3m to browse HexDocs in this popup. Press Enter to close.')
        try:
            input()
        except EOFError:
            pass
        return
    os.execv(browser, [browser, url])


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError):
        print('Cannot open HexDocs.', file=sys.stderr)
        sys.exit(1)
