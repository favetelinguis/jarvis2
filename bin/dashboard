#!/usr/bin/python3
"""Render the Jarvis2 dashboard in a Herdr popup."""
import json
import os
import select
import shutil
import sys
import termios
import tty
import unicodedata
import urllib.error
import urllib.request
from pathlib import Path


def clean(value):
    return "".join(
        char for char in str(value or "-")
        if not unicodedata.category(char).startswith("C")
    )[:160]


def fetch():
    try:
        port = int(os.environ.get("JARVIS2_PORT", "4747"))
        if not 1 <= port <= 65535:
            raise ValueError("invalid port")
        state = os.environ.get("JARVIS2_DASHBOARD_STATE_DIR") or os.environ.get(
            "HERDR_PLUGIN_STATE_DIR"
        ) or str(Path.home() / ".local/state/herdr/plugins/favetelinguis.jarvis2")
        token = (Path(state) / "token").read_text(encoding="utf-8").strip()
        request = urllib.request.Request(
            f"http://127.0.0.1:{port}/dashboard",
            headers={"Authorization": f"Bearer {token}"},
        )
        opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
        with opener.open(request, timeout=2) as response:
            return json.load(response)
    except (OSError, ValueError, json.JSONDecodeError, urllib.error.URLError):
        return None


def render(data):
    width = shutil.get_terminal_size((80, 24)).columns
    lines = ["Jarvis2 dashboard  (q to close)"]
    if not isinstance(data, dict):
        return "\n".join(lines + ["Server unavailable; run action start-server."])
    lines += ["Mirror: " + ("stale" if data.get("stale") else "connected"), "", "Agents"]
    agents = data.get("agents", [])[:5]
    lines.extend(
        f"  {clean(agent.get('pane_id'))} {clean(agent.get('name') or agent.get('agent'))} {clean(agent.get('agent_status'))}"
        for agent in agents
    )
    if not agents:
        lines.append("  (none)")
    lines += ["", "Recent events"]
    events = data.get("events", [])[-5:]
    lines.extend(
        f"  {clean(event.get('delivery'))} {clean(event.get('type') or event.get('id'))}"
        for event in events
    )
    if not events:
        lines.append("  (none)")
    lines += ["", "MCP journal"]
    journal = data.get("journal", [])[-5:]
    lines.extend(
        f"  {clean(entry.get('pane'))} {clean(entry.get('tool'))} {clean(entry.get('outcome'))}"
        for entry in journal
    )
    if not journal:
        lines.append("  (none)")
    return "\n".join(line[: max(width - 1, 1)] for line in lines)


def main():
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        print(render(fetch()))
        return
    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd)
    try:
        tty.setcbreak(fd)
        sys.stdout.write("\x1b[?1049h\x1b[?25l")
        while True:
            sys.stdout.write("\x1b[H\x1b[2J" + render(fetch()))
            sys.stdout.flush()
            if select.select([sys.stdin], [], [], 1)[0]:
                key = sys.stdin.read(1)
                if key in ("q", "Q", "\x04", ""):
                    break
    except KeyboardInterrupt:
        pass
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)
        sys.stdout.write("\x1b[?25h\x1b[?1049l")
        sys.stdout.flush()


if __name__ == "__main__":
    main()
