#!/usr/bin/python3
"""A single authenticated Jarvis2 human-question popup."""
import json
import os
import sys
import unicodedata
import urllib.error
import urllib.request


def safe(text):
    return ''.join(c if not unicodedata.category(c).startswith('C') or c == '\n' else ' ' for c in text)


def main():
    request_id = os.environ['JARVIS2_PICKER_ID']
    if len(request_id) != 32 or any(c not in 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_' for c in request_id):
        raise ValueError('invalid request id')
    port = int(os.environ['JARVIS2_PICKER_PORT'])
    if not 1 <= port <= 65535:
        raise ValueError('invalid port')
    with open(os.environ['JARVIS2_PICKER_TOKEN_FILE'], encoding='utf-8') as f:
        token = f.read().strip()
    url = f'http://127.0.0.1:{port}/picker/{request_id}'
    headers = {'Authorization': 'Bearer ' + token}
    with urllib.request.urlopen(urllib.request.Request(url, headers=headers), timeout=5) as response:
        request = json.load(response)
    print('\n' + safe(request['question']) + '\n')
    choices = request['choices']
    for index, choice in enumerate(choices, 1):
        print(f'  {index}. {safe(choice)}')
    try:
        if choices:
            while True:
                value = input('\nChoice number (blank to cancel): ').strip()
                if not value:
                    answer = {'cancel': True}
                    break
                if value.isascii() and value.isdigit() and 1 <= int(value) <= len(choices):
                    answer = {'index': int(value) - 1}
                    break
                print('Enter one of the displayed numbers.')
        else:
            value = input('Answer (blank to cancel): ')
            answer = {'text': value} if value else {'cancel': True}
    except (EOFError, KeyboardInterrupt):
        answer = {'cancel': True}
    body = json.dumps(answer).encode()
    headers['Content-Type'] = 'application/json'
    req = urllib.request.Request(url, data=body, headers=headers, method='POST')
    with urllib.request.urlopen(req, timeout=5):
        pass


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, KeyError, urllib.error.URLError):
        print('Jarvis2 picker unavailable or request expired.', file=sys.stderr)
        sys.exit(1)
