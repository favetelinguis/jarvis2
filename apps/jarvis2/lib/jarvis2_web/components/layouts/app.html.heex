<header class="nav">
  <strong>Jarvis2</strong>
  <nav>
    <.link navigate="/">Dashboard</.link>
    <.link navigate="/runs">Runs</.link>
    <.link navigate="/blackboard">Blackboard</.link>
    <.link navigate="/events">Events</.link>
    <.link navigate="/settings">Settings</.link>
    <.link navigate="/inbox">
      Inbox
      <span :if={@inbox_count > 0} id="inbox-count" class="badge badge-blocked">{@inbox_count}</span>
    </.link>
  </nav>
  <.form for={%{}} action="/logout" method="delete" class="logout">
    <button type="submit">Sign out</button>
  </.form>
</header>
<main>
  <p :if={msg = Phoenix.Flash.get(@flash, :error)} class="flash flash-error">{msg}</p>
  <p :if={msg = Phoenix.Flash.get(@flash, :info)} class="flash">{msg}</p>
  {@inner_content}
</main>
